---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import Rulebook from '../components/Rulebook.astro';
import { stages, categories, venues } from '../data/program';
import { links, prices, rulebooks } from '../data/site';
---
<Layout title="El Mundial · Final Nacional Argentina" description="El Mundial 2026: etapas, categorías, eliminatorias argentinas, inscripción y acceso al reglamento. Final Nacional en el marco de Comadreja Salsa Congress.">
  <PageIntro eyebrow="Final Nacional Argentina · 26 y 27 de noviembre" title="El" accent="Mundial" description="Creado por Karen y Ricardo, nueve veces campeones mundiales. Más de 20 años llevando el baile latino a un nivel profesional sin precedentes. Un nuevo comienzo, un nuevo legado: donde los sueños se convierten en historia." number="01"><div class="button-row"><Button href={links.mundial}>Info de inscripción</Button><Button href="#reglamento" variant="outline">Reglamento</Button></div></PageIntro>
  <section class="section"><div class="container"><SectionHeading eyebrow="Cómo se compite" title="Cinco etapas. Un nuevo legado." description="Eliminatorias nacionales, formación y duelos hasta coronar a los mejores del mundo." /><div class="stages">{stages.map(stage => <article class="stage"><span>{stage.number}</span><div><h3>{stage.title}</h3><p>{stage.description}</p></div></article>)}</div></div></section>
  <section class="section cream" id="categorias"><div class="container"><SectionHeading eyebrow="Categorías" title="Un lugar para cada bailarín." /><div class="grid-two content-gap"><div class="category-block"><h3>Por estilo de baile</h3><ul class="tags">{categories.styles.map(style => <li>{style}</li>)}</ul><p>Cada estilo incluye solista, dúo shine, parejas classic y cabaret, grupos, team shine y categoría Queer.</p><ul class="tags content-gap">{categories.formats.map(format => <li>{format}</li>)}</ul></div><div class="category-block"><h3>Por nivel y por edad</h3><ul class="tags">{categories.levels.map(level => <li>{level}</li>)}</ul><h3 class="content-gap">Edades</h3><ul class="tags">{categories.ages.map(age => <li>{age}</li>)}</ul><p>El reglamento completo detalla puntajes, tiempos de presentación y penalizaciones por categoría.</p></div></div><div id="reglamento"><Rulebook competition="El Mundial" href={links.mundial} file={rulebooks.mundial} /></div></div></section>
  <section class="section" id="sedes"><div class="container"><SectionHeading eyebrow="Sedes en toda la Argentina" title="Encontrá tu eliminatoria." description="Eliminatorias en todo el país. La fecha del 1 de noviembre corresponde a la eliminatoria de la sede Córdoba." /><div class="content-gap"><Notice title="Final Nacional Argentina">La Final Nacional reúne a participantes de todas las sedes del país el 26 y 27 de noviembre en Hotel Estilo MB, Almafuerte 40, Villa Carlos Paz. Todas las inscripciones se coordinan con Isa. <a href={links.mundial} target="_blank" rel="noopener noreferrer">Consultar inscripción ↗</a></Notice></div><ul class="venue-list content-gap">{venues.map(([date, venue, instagram]) => <li><time>{date}</time><strong>{venue}</strong><a href={`https://www.instagram.com/${instagram}`} target="_blank" rel="noopener noreferrer">@{instagram} ↗</a></li>)}</ul></div></section>
  <section class="section cream"><div class="container grid-two"><div><SectionHeading eyebrow="Inscripción a El Mundial" title={`Desde ${prices.mundial}`} /><ul class="price-table">{prices.categories.map(category => <li><span>{category.label}</span><strong>{category.amount}</strong></li>)}</ul><p class="fineprint">{prices.categoryNote}</p><div class="content-gap"><Button href={links.mundial} variant="wine">Quiero inscribirme</Button></div></div><div class="prose"><h3>¿Full Pass o solo Mundial?</h3><p>El Full Pass incluye tu inscripción a El Mundial, al Battle Master, todos los talleres y las noches de social.</p><p>Si solo querés competir jueves y viernes, la inscripción a El Mundial te alcanza.</p><div class="content-gap"><Button href={withBase('/precios.html')} variant="outline">Comparar precios</Button></div></div></div></section>
</Layout>
