---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArtistCard from '../components/ArtistCard.astro';
import Picture from '../components/Picture.astro';
import PassBanner from '../components/PassBanner.astro';
import Button from '../components/Button.astro';
import artists from '../data/artists.json';
---
<Layout title="Artistas, compañías y DJs" description="Karen y Ricardo, Carine y Rafael, Anthony y Belén y la grilla completa de artistas, compañías, conductores y DJs de Comadreja Salsa Congress 2026.">
  <PageIntro eyebrow="Más de 20 artistas en escena" title="El mundo" accent="en la pista." description="Artistas de primer nivel, internacionales y nacionales, encabezan una grilla de más de veinte bailarines, con sets de DJs de toda la Argentina." number="04" />
  <div class="container"><nav class="artist-jumpnav" aria-label="Secciones de artistas"><a href="#internacionales">Internacionales</a><a href="#grilla">Toda la grilla</a><a href="#companias">Compañías</a><a href="#conduccion">Conducción</a><a href="#djs">DJs</a></nav></div>
  <section class="section" id="internacionales"><div class="container"><SectionHeading eyebrow="Artistas internacionales" title="Referentes que cruzan fronteras." /><div class="featured-artists content-gap">{artists.filter(a => a.category === 'Artistas internacionales').map(artist => <ArtistCard artist={artist} featured />)}</div></div></section>
  <section class="section wine" id="grilla"><div class="container"><SectionHeading eyebrow="Y muchos más" title="El resto de la grilla." description="Más de 20 artistas suben al escenario de Comadreja durante los cuatro días de shows y talleres." /><div class="artists-grid">{artists.filter(a => a.category === 'El resto de la grilla').map(artist => <ArtistCard artist={artist} />)}</div></div></section>
  <section class="section" id="companias"><div class="container"><SectionHeading eyebrow="Compañías invitadas" title="El baile se comparte." /><div class="grid-two groups-grid">{artists.filter(a => a.category === 'Grupos de baile').map(group => <article class="group-card"><Picture name={group.image.split('/').at(-1)!} alt={group.imageAlt} sizes="(min-width: 768px) 550px, 90vw" /><h3>{group.name}</h3><p>{group.origin}</p></article>)}</div></div></section>
  <section class="section cream" id="conduccion"><div class="container grid-two"><div><SectionHeading eyebrow="En el escenario" title="Las voces de Comadreja." /><p class="lede content-gap">Ariel Cechel, Gaby Zamora, Seba La Vega, Maxi Vergara y Ulises Pico conducen los cuatro días de Comadreja Salsa Congress.</p><ul class="roster-list">{artists.filter(a => a.category === 'Conducción').map(host => <li><strong>{host.name}</strong><span>Conducción</span></li>)}</ul></div><Picture name="group-locutores.jpg" alt="Ariel Cechel, Gaby Zamora, Seba La Vega y Maxi Vergara, conductores de Comadreja Salsa Congress" class="roster-image" sizes="(min-width: 768px) 440px, 90vw" /></div></section>
  <section class="section" id="djs"><div class="container grid-two"><div><SectionHeading eyebrow="En cabina" title="El pulso de la noche." description="Sets de DJs de salsa y bachata del país." /><ul class="roster-list">{artists.filter(a => a.category === 'DJs y música en vivo').map(dj => <li><strong>{dj.name}</strong><span>{dj.origin}</span></li>)}</ul><Button href={withBase('/talleres.html')} variant="outline">Ver talleres y noches de social</Button></div><Picture name="dj-lineup.jpg" alt="Afiche oficial de DJ Joseco, DJ Fede Ramírez, DJ Moon, DJ Tito y DJ Matias Casco" class="roster-image" sizes="(min-width: 768px) 440px, 90vw" /></div></section>
  <PassBanner />
</Layout>
