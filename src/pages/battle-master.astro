---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import Rulebook from '../components/Rulebook.astro';
import PassBanner from '../components/PassBanner.astro';
import { links, conflicts } from '../data/site';
const criteria = ['Musicalidad', 'Técnica', 'Tiempo y ritmo', 'Presencia escénica'];
const movements = ['Shines', 'Footwork', 'Estilo libre', 'Movimientos corporales', 'Interpretación musical'];
const forbidden = ['Contacto físico agresivo', 'Insultos o gestos obscenos', 'Coreografía preparada evidente', 'Bailar fuera del género musical sorteado', 'Acrobacias peligrosas'];
---
<Layout title="Comadreja Battle Master 1vs1" description="Batallas de salsa y bachata 1vs1: formato, evaluación, premios publicados, reglamento e inscripción con Rodrigo Perazolo.">
  <PageIntro eyebrow="1 vs 1 · Eliminación directa" title="Battle" accent="Master" description="Acá no hay coreografía: manda la improvisación real, la conexión con la música y la actitud en escena. Solo los verdaderos masters dominan la pista." number="02"><div class="button-row"><Button href={links.battle}>Inscribirme con Rodrigo</Button><Button href="#reglamento" variant="outline">Reglamento</Button></div></PageIntro>
  <section class="section cream"><div class="container"><SectionHeading eyebrow="El formato" title="Cara a cara. Frente al jurado." /><div class="battle-stats content-gap"><div><strong>2 rounds</strong><span>Por bailarín, 30 segundos cada uno.</span></div><div><strong>5 jueces</strong><span>Deciden por voto de mayoría simple.</span></div><div><strong>Salsa y bachata</strong><span>Música sorteada de una lista oficial.</span></div><div><strong>4 rondas</strong><span>Eliminatorias, cuartos, semifinal y final.</span></div></div></div></section>
  <section class="section"><div class="container"><div class="grid-two"><div><SectionHeading eyebrow="Qué se evalúa" title="Improvisación, musicalidad y estilo." /><p class="lede content-gap">No es una coreografía preparada, sino una interpretación espontánea del bailarín.</p><ul class="tags content-gap">{criteria.map(item => <li>{item}</li>)}</ul><h3 class="content-gap">Tu lenguaje en la pista</h3><ul class="tags content-gap">{movements.map(item => <li>{item}</li>)}</ul></div><div class="prose"><span class="eyebrow">Reglas de la competencia</span><h3>No se permite</h3><ul class="plain-list">{forbidden.map(item => <li>{item}</li>)}</ul><div class="content-gap"><p>Los competidores que quieran ser parte deben inscribirse directamente con Rodrigo Perazolo.</p><p>La inscripción al Battle Master ya está incluida dentro del Full Pass del congreso.</p></div></div></div><div id="reglamento"><Rulebook competition="Battle Master" href={links.battle} /></div></div></section>
  <section class="section cream"><div class="container"><SectionHeading eyebrow="Premios" title="El cinturón espera a su master." /><div class="content-gap prize-panel" style="color:var(--cream);--muted:#d2c3bb"><span class="eyebrow" style="color:var(--gold)">Premio publicado en la sección Battle Master</span><div class="prize-amount">$250.000</div><p>+ cinturón Battle Master, para el Master de Salsa y el Master de Bachata. Cada cinturón lleva una chapa con la fecha y el nombre del campeón.</p><Notice title="Monto y distribución por confirmar">{conflicts.battlePrize}</Notice><div class="content-gap"><Button href={links.battle}>Consultar con Rodrigo · 351 206 6472</Button></div></div></div></section>
  <PassBanner />
</Layout>
