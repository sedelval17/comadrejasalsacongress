---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import InfoBlock from '../components/InfoBlock.astro';
import { prices, links } from '../data/site';
const fullPasses = [
  { title: 'Full Pass Espectador', amount: prices.fullPass, audience: 'Para asistir como espectador', includes: prices.spectatorIncludes, note: 'No incluye inscripción a El Mundial ni a Battle Master.', href: links.spectatorPass, action: 'Reservar como espectador' },
  { title: 'Full Pass Competidor', amount: prices.competitorPass, audience: 'Para quienes compiten', includes: prices.competitorIncludes, note: 'Incluye las inscripciones a El Mundial y Battle Master.', href: links.competitorPass, action: 'Reservar como competidor' },
];
---
<Layout title="Precios y formas de pago" description="Pases anticipados: Full Pass Espectador $200.000, Competidor $180.000, Congreso CSC $160.000, Social $80.000 y Juvenil $90.000. Reservas y pagos con Isa.">
  <PageIntro eyebrow="Venta anticipada · Comadreja 2026" title="Tu lugar" accent="en Comadreja." description="Un Full Pass, una inscripción a la competencia o una noche en la pista. Elegí tu pase y coordiná tu reserva con Isa por WhatsApp." number="05" />
  <section class="section"><div class="container">
    <div class="advance-prices"><span class="eyebrow">Anticipadas</span><p>{prices.advanceNote}</p></div>
    <div class="pricing-grid content-gap">{fullPasses.map((pass, index) => <article class:list={['price-card', { featured: index === 1 }]}>
      <span class="eyebrow">{pass.audience} · anticipado</span><h2>{pass.title}</h2><p class="price">{pass.amount}</p>
      <ul class="check-list">{pass.includes.map(item => <li><Icon name="check" /><span>{item}</span></li>)}</ul>
      <p class="pass-note">{pass.note}</p>
      <Button href={pass.href}>{pass.action}</Button>
    </article>)}</div>
  </div></section>
  <section class="section cream"><div class="container">
    <SectionHeading eyebrow="Más formas de vivir el congreso" title="Elegí tu pase." description="Valores de venta anticipada. Encontrá la opción que va con vos." />
    <div class="other-passes content-gap">{prices.otherPasses.map(pass => <article class="other-pass"><h3>{pass.name}</h3><p class="other-pass-price">{pass.amount}</p><p>{pass.details}</p><a class="underlink" href={links.info} target="_blank" rel="noopener noreferrer">Consultar con Isa <Icon name="external" /></a></article>)}</div>
  </div></section>
  <section class="section competition-pricing"><div class="container grid-two">
    <div><SectionHeading eyebrow="Inscripción a la competencia" title="El Mundial" /><p class="competition-start-price">Desde {prices.mundial}</p><ul class="price-table">{prices.categories.map(category => <li><span>{category.label}</span><strong>{category.amount}</strong></li>)}</ul><p class="fineprint">{prices.categoryNote}</p></div>
    <div class="prose"><h3>Final Nacional Argentina</h3><p>26 y 27 de noviembre en Villa Carlos Paz. Elegí la inscripción por categorías o el Full Pass Competidor de {prices.competitorPass}, que incluye todas las categorías y el congreso completo.</p><p>Los pagos y comprobantes se coordinan con Isa. El registro de finalistas se completa en la plataforma oficial de El Mundial hasta el 8 de noviembre de 2026.</p><div class="button-row content-gap"><Button href={withBase('/el-mundial.html#inscripcion')}>Ver cómo inscribirme</Button><Button href={links.mundial} variant="outline">Consultar con Isa</Button></div></div>
  </div></section>
  <section class="section cream"><div class="container"><SectionHeading eyebrow="Noches de social · anticipadas" title="La pista también te espera." description="Entradas individuales para las noches de social." /><div class="night-prices">{prices.nights.map(night => <article class="night-price"><span class="eyebrow">{night.date}</span><h3>{night.day}</h3><strong>{night.price}</strong>{night.note && <p class="fineprint">{night.note}</p>}</article>)}</div><p class="social-price-note">{prices.advanceNote}</p><Button href={links.social} variant="wine">Reservar entrada a la social</Button></div></section>
  <section class="section" id="formas-de-pago"><div class="container"><SectionHeading eyebrow="Cómo pagar" title="Elegí tu forma de pago." /><div class="payment-grid"><div><span class="payment-number">01</span><h3>Efectivo</h3><p>Coordinalo directamente con Isa por WhatsApp.</p></div><div><span class="payment-number">02</span><h3>Transferencia</h3><p>Los datos bancarios se comparten al confirmar tu reserva.</p></div><div><span class="payment-number">03</span><h3>Tarjeta · Mercado Pago</h3><p>Escribinos y te enviamos el link de pago directo a tu WhatsApp.</p></div></div><div class="content-gap"><InfoBlock title="Reservas, pagos y consultas">Para reservar tu Full Pass, consultar tu inscripción o enviar un comprobante, escribile a Isa. El registro de la Final Nacional se completa en la plataforma oficial de El Mundial.</InfoBlock></div><div class="button-row content-gap"><Button href={links.info}>Hablar con Isa · WhatsApp</Button><Button href={links.battle} variant="outline">Battle Master · Isa</Button></div></div></section>
</Layout>
