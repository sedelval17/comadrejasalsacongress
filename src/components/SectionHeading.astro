---
interface Props { eyebrow: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<div class="section-heading"><span class="eyebrow"><span class="little-star" aria-hidden="true">✦</span> {eyebrow}</span><h2>{title}</h2>{description && <p class="lede">{description}</p>}</div>
