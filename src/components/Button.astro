---
import Icon from './Icon.astro';
import { withBase } from '../lib/urls';
interface Props { href: string; variant?: 'gold' | 'outline' | 'wine' | 'text'; class?: string; }
const { href, variant = 'gold', class: className } = Astro.props;
const external = href.startsWith('https://');
---
<a class:list={['button', `button-${variant}`, className]} href={withBase(href)} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><slot /><Icon name={external ? 'external' : 'arrow'} /></a>
