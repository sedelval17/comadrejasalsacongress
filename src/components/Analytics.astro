<!-- Google Analytics runs only on the public website, keeping local previews out of reports. -->
<script is:inline>
  (() => {
    if (!['comadrejaproducciones.com', 'www.comadrejaproducciones.com'].includes(window.location.hostname)) return;

    const measurementId = 'G-333B755VPE';
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
    document.head.appendChild(script);
  })();
</script>
