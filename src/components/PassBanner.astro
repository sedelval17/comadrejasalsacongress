---
import { withBase } from '../lib/urls';
import Button from './Button.astro';
import { links, prices, event } from '../data/site';
---
<section class="pass-banner"><div class="container pass-banner-inner"><div><span class="eyebrow">{event.dates} · {event.year}</span><h2>Todo el congreso.<br /><span>Un solo acceso.</span></h2></div><div class="pass-banner-action"><span class="pass-label">FULL PASS ESPECTADOR</span><p class="pass-price">{prices.fullPass}</p><p class="pass-competitor">Full Pass Competidor: <strong>{prices.competitorPass}</strong></p><span class="pass-advance">Valores de venta anticipada</span><Button href={withBase('/precios.html')}>Elegir mi Full Pass</Button><a class="underlink" href={links.info} target="_blank" rel="noopener noreferrer">Consultar con Isa</a></div></div></section>
