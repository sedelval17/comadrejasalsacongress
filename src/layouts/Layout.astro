---
import { withBase, withoutBase } from '../lib/urls';
import '../styles/fonts.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import oswaldFont from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { event, navigation, socials, links } from '../data/site';
import Icon from '../components/Icon.astro';
interface Props { title: string; description: string; path?: string; }
const { title, description, path = Astro.url.pathname } = Astro.props;
const route = withoutBase(path);
const active = route === '/index.html' ? '/' : route;
const canonical = new URL(withBase(active), Astro.site);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3e111d" />
    <title>{title} | Comadreja Salsa Congress 2026</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={oswaldFont} as="font" type="font/woff2" crossorigin />
    {(__COMADREJA_PREVIEW__ || route.startsWith('/404')) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={withBase('/assets/original/logo-2026.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Comadreja Salsa Congress" />
    <meta property="og:title" content={`${title} · Comadreja 2026`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/assets/brand/comadreja-logo-reconstruido-v1.webp'), Astro.site)} />
    <meta property="og:image:alt" content="Comadreja Salsa Congress 2026" />
    <meta property="og:image:width" content="2170" />
    <meta property="og:image:height" content="725" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase('/')} aria-label="Comadreja Salsa Congress 2026, inicio"><img src={withBase('/assets/brand/comadreja-logo-reconstruido-v1.webp')} width="2170" height="725" alt="Comadreja 2026 Salsa Congress" decoding="async" /></a>
        <nav class="desktop-nav" aria-label="Navegación principal">{navigation.map(item => <a href={withBase(item.href)} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
        <a class="header-pass" href={links.fullPass} target="_blank" rel="noopener noreferrer">Full Pass <Icon name="external" /></a>
        <details class="mobile-menu"><summary aria-label="Menú de navegación"><span class="menu-lines" aria-hidden="true"></span><span>Menú</span></summary><nav aria-label="Navegación móvil">{navigation.map((item, index) => <a href={withBase(item.href)} aria-current={active === item.href ? 'page' : undefined}><span class="menu-index">0{index + 1}</span>{item.label}<Icon /></a>)}<a class="mobile-pass" href={links.fullPass} target="_blank" rel="noopener noreferrer">Quiero mi Full Pass <Icon name="external" /></a></nav></details>
      </div>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="container"><div class="footer-top"><a class="brand" href={withBase('/')} aria-label="Comadreja Salsa Congress 2026, inicio"><img src={withBase('/assets/brand/comadreja-logo-reconstruido-v1.webp')} width="2170" height="725" alt="Comadreja 2026 Salsa Congress" decoding="async" /></a><p>Más que historia,<br />una experiencia.</p><a class="back-top" href="#contenido">Volver arriba <span aria-hidden="true">↑</span></a></div><div class="footer-grid"><div><span class="eyebrow">Nos vemos en Córdoba</span><p>{event.dates} de {event.year}<br />{event.venue}<br />{event.address}.</p><a class="underlink" href={withBase('/contacto.html#ubicacion')}>Cómo llegar <Icon name="external" /></a></div><nav aria-label="Navegación de pie de página"><span class="eyebrow">Explorá el congreso</span>{navigation.filter(item => item.href !== '/').map(item => <a href={withBase(item.href)}>{item.label}</a>)}</nav><div><span class="eyebrow">Sigamos en contacto</span><a href={links.info} target="_blank" rel="noopener noreferrer">WhatsApp Isa · Full Pass e inscripciones <Icon name="external" /></a>{socials.map(social => <a href={social.url} target="_blank" rel="noopener noreferrer">{social.name} <Icon name="instagram" /></a>)}</div></div><div class="footer-bottom"><span>© 2026 Comadreja Producciones.</span><span>Programa sujeto a cambios.</span><span>Villa Carlos Paz · Argentina</span></div></div></footer>
    <a class="contact-float" href={links.info} target="_blank" rel="noopener noreferrer" aria-label="Consultar a Isa por WhatsApp"><Icon name="whatsapp" /></a>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
      document.addEventListener('click', (event) => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
      matchMedia('(min-width: 1100px)').addEventListener('change', (event) => { if (event.matches && menu) menu.open = false; });
    </script>
  </body>
</html>
